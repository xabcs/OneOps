package services

import (
	"context"
	"fmt"
	"sync"
	"time"

	"oneops/backend/config"
	"oneops/backend/logger"
	"oneops/backend/models"

	"go.uber.org/zap"
	"gorm.io/gorm"
)

// MetricsCollector 监控指标采集器
type MetricsCollector struct {
	db            *gorm.DB
	cache         *RedisCache
	stopChan      chan struct{}
	tickers       map[string]*time.Ticker
	wg            sync.WaitGroup
	collecting    map[uint]bool // 正在采集的服务器标记，防止重复
	collectingMux sync.RWMutex
}

// NewMetricsCollector 创建采集器
func NewMetricsCollector() *MetricsCollector {
	return &MetricsCollector{
		db:         models.GetDB(),
		cache:      NewRedisCache(),
		tickers:    make(map[string]*time.Ticker),
		collecting: make(map[uint]bool),
	}
}

// Start 启动采集服务
func (c *MetricsCollector) Start() {
	logger.Info("启动监控数据采集服务...")

	// 1. 快速采集：性能指标（每分钟）
	c.startFastCollector()

	// 2. 常规采集：系统/网络/安全信息（每5分钟）
	c.startRegularCollector()

	// 3. 慢速采集：硬件信息（每30分钟）
	c.startSlowCollector()

	// 4. 数据库清理：清理过期数据（每小时）
	c.startDataCleaner()

	// 5. 健康检查：检测 Agent 状态（每2分钟）
	c.startHealthChecker()

	logger.Info("监控数据采集服务启动完成")
}

// Stop 停止采集服务
func (c *MetricsCollector) Stop() {
	logger.Info("停止监控数据采集服务...")

	// 停止所有定时器
	for name, ticker := range c.tickers {
		ticker.Stop()
		logger.Debug("停止定时器", zap.String("name", name))
	}

	// 等待所有采集任务完成
	close(c.stopChan)
	c.wg.Wait()

	logger.Info("监控数据采集服务已停止")
}

// startFastCollector 快速采集器（性能指标，每分钟）
func (c *MetricsCollector) startFastCollector() {
	ticker := time.NewTicker(1 * time.Minute)
	c.tickers["fast"] = ticker

	c.wg.Add(1)
	go func() {
		defer c.wg.Done()
		defer ticker.Stop()

		for {
			select {
			case <-ticker.C:
				c.collectFastMetrics()
				logger.Debug("快速采集完成")
				case <-c.stopChan:
					return
			}
		}
	}()
}

// startRegularCollector 常规采集器（系统/网络/安全，每5分钟）
func (c *MetricsCollector) startRegularCollector() {
	ticker := time.NewTicker(5 * time.Minute)
	c.tickers["regular"] = ticker

	c.wg.Add(1)
	go func() {
		defer c.wg.Done()
		defer ticker.Stop()

		for {
			select {
			case <-ticker.C:
				c.collectRegularMetrics()
				logger.Debug("常规采集完成")
				case <-c.stopChan:
					return
			}
		}
	}()
}

// startSlowCollector 慢速采集器（硬件信息，每30分钟）
func (c *MetricsCollector) startSlowCollector() {
	ticker := time.NewTicker(30 * time.Minute)
	c.tickers["slow"] = ticker

	c.wg.Add(1)
	go func() {
		defer c.wg.Done()
		defer ticker.Stop()

		for {
			select {
			case <-ticker.C:
				c.collectSlowMetrics()
				logger.Debug("慢速采集完成")
				case <-c.stopChan:
					return
			}
		}
	}()
}

// startDataCleaner 数据清理器（每小时清理过期数据）
func (c *MetricsCollector) startDataCleaner() {
	ticker := time.NewTicker(1 * time.Hour)
	c.tickers["cleaner"] = ticker

	c.wg.Add(1)
	go func() {
		defer c.wg.Done()
		defer ticker.Stop()

		for {
			select {
			case <-ticker.C:
				c.cleanExpiredData()
				logger.Debug("数据清理完成")
				case <-c.stopChan:
					return
			}
		}
	}()
}

// startHealthChecker 健康检查器（每2分钟检查 Agent 状态）
func (c *MetricsCollector) startHealthChecker() {
	ticker := time.NewTicker(2 * time.Minute)
	c.tickers["health"] = ticker

	c.wg.Add(1)
	go func() {
		defer c.wg.Done()
		defer ticker.Stop()

		for {
			select {
			case <-ticker.C:
				c.checkAgentHealth()
				logger.Debug("健康检查完成")
				case <-c.stopChan:
					return
			}
		}
	}()
}

// collectFastMetrics 采集性能指标（快速）
func (c *MetricsCollector) collectFastMetrics() {
	servers := c.getActiveServers()
	if len(servers) == 0 {
		return
	}

	// 分批采集，每批 10 台服务器
	batchSize := 10
	batches := c.splitServers(servers, batchSize)

	var wg sync.WaitGroup
	successCount := 0
	failCount := 0

	for _, batch := range batches {
		wg.Add(1)
		go func(srvs []models.Server) {
			defer wg.Done()

			for _, server := range srvs {
				if err := c.collectServerMetrics(server.ID, "fast"); err != nil {
					logger.Warn("快速采集失败",
						zap.Uint("serverID", server.ID),
						zap.String("hostname", server.Hostname),
						zap.Error(err))
					failCount++
					c.markServerOffline(server.ID)
				} else {
					successCount++
					c.markServerOnline(server.ID)
				}

				// 避免同时拉取造成 Agent 压力
				time.Sleep(100 * time.Millisecond)
			}
		}(batch)

		// 批次间稍微延迟，避免并发过高
		time.Sleep(500 * time.Millisecond)
	}

	wg.Wait()

	logger.Info("快速采集完成",
		zap.Int("total", len(servers)),
		zap.Int("success", successCount),
		zap.Int("failed", failCount))
}

// collectRegularMetrics 采集常规指标（系统、网络、安全）
func (c *MetricsCollector) collectRegularMetrics() {
	servers := c.getActiveServers()
	if len(servers) == 0 {
		return
	}

	batchSize := 20
	batches := c.splitServers(servers, batchSize)

	var wg sync.WaitGroup
	for _, batch := range batches {
		wg.Add(1)
		go func(srvs []models.Server) {
			defer wg.Done()

			for _, server := range srvs {
				// 只采集需要的类型，跳过已经采集过的
				c.collectServerMetrics(server.ID, "regular")
				time.Sleep(50 * time.Millisecond)
			}
		}(batch)

		time.Sleep(200 * time.Millisecond)
	}

	wg.Wait()
}

// collectSlowMetrics 采集慢速指标（硬件信息）
func (c *MetricsCollector) collectSlowMetrics() {
	servers := c.getActiveServers()
	if len(servers) == 0 {
		return
	}

	// 慢速采集不分批，串行执行即可
	for _, server := range servers {
		c.collectServerMetrics(server.ID, "slow")
		time.Sleep(200 * time.Millisecond)
	}
}

// collectServerMetrics 采集单台服务器指标
func (c *MetricsCollector) collectServerMetrics(serverID uint, mode string) error {
	// 检查是否正在采集
	c.collectingMux.RLock()
	if c.collecting[serverID] {
		c.collectingMux.RUnlock()
		return fmt.Errorf("服务器 %d 正在采集中", serverID)
	}
	c.collectingMux.RUnlock()

	// 标记开始采集
	c.collectingMux.Lock()
	c.collecting[serverID] = true
	c.collectingMux.Unlock()

	defer func() {
		c.collectingMux.Lock()
		delete(c.collecting, serverID)
		c.collectingMux.Unlock()
	}()

	// 调用监控服务拉取数据
	monitoringService := NewMonitoringService()
	metrics, err := monitoringService.PullExtendedMetrics(serverID)
	if err != nil {
		return err
	}

	// 根据模式缓存到 Redis（不同的 TTL）
	cache := NewRedisCache()
	switch mode {
	case "fast":
		// 快速数据缓存 1 分钟
		if err := cache.CacheServerMetricsWithTTL(serverID, *metrics, 1*time.Minute); err != nil {
			logger.Warn("缓存快速指标失败", zap.Error(err))
		}
	case "regular":
		// 常规数据缓存 5 分钟
		if err := cache.CacheServerMetricsWithTTL(serverID, *metrics, 5*time.Minute); err != nil {
			logger.Warn("缓存常规指标失败", zap.Error(err))
		}
	case "slow":
		// 慢速数据缓存 30 分钟
		if err := cache.CacheServerMetricsWithTTL(serverID, *metrics, 30*time.Minute); err != nil {
			logger.Warn("缓存慢速指标失败", zap.Error(err))
		}
	}

	return nil
}

// checkAgentHealth 检查 Agent 健康状态
func (c *MetricsCollector) checkAgentHealth() {
	var servers []models.Server
	db.Where("agent_status = ?", "running").Find(&servers)

	for _, server := range servers {
		// 尝试拉取数据
		monitoringService := NewMonitoringService()
		_, err := monitoringService.PullExtendedMetrics(server.ID)

		if err != nil {
			// 连续失败次数达到阈值，标记为离线
			c.markServerOffline(server.ID)
			logger.Warn("Agent 健康检查失败",
				zap.Uint("serverID", server.ID),
				zap.String("hostname", server.Hostname),
				zap.Error(err))
		} else {
			c.markServerOnline(server.ID)
		}
	}
}

// cleanExpiredData 清理过期数据
func (c *MetricsCollector) cleanExpiredData() {
	// 清理 7 天前的性能指标
	retentionDays := 7
	result := db.Exec(`
		DELETE FROM agent_metrics
		WHERE received_at < DATE_SUB(NOW(), INTERVAL ? DAY)
	`, retentionDays)

	if result.Error != nil {
		logger.Error("清理过期数据失败", zap.Error(result.Error))
		return
	}

	if result.RowsAffected > 0 {
		logger.Info("清理过期数据完成",
			zap.Int64("rows", result.RowsAffected),
			zap.Int("retention_days", retentionDays))
	}
}

// getActiveServers 获取活跃服务器列表
func (c *MetricsCollector) getActiveServers() []models.Server {
	var servers []models.Server
	db.Where("agent_status = ?", "running").Find(&servers)
	return servers
}

// splitServers 将服务器列表分批
func (c *MetricsCollector) splitServers(servers []models.Server, batchSize int) [][]models.Server {
	var batches [][]models.Server

	for i := 0; i < len(servers); i += batchSize {
		end := i + batchSize
		if end > len(servers) {
			end = len(servers)
		}
		batches = append(batches, servers[i:end])
	}

	return batches
}

// markServerOnline 标记服务器在线
func (c *MetricsCollector) markServerOnline(serverID uint) {
	now := time.Now()
	db.Model(&models.Server{}).
		Where("id = ?", serverID).
		Updates(map[string]interface{}{
			"agent_status":      "running",
			"last_heartbeat_at": now,
			"status":            "online",
		})
}

// markServerOffline 标记服务器离线
func (c *MetricsCollector) markServerOffline(serverID uint) {
	db.Model(&models.Server{}).
		Where("id = ?", serverID).
		Updates(map[string]interface{}{
			"agent_status": "offline",
			"status":       "offline",
		})
}
