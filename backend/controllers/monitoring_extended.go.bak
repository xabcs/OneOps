package controllers

import (
	"net/http"
	"oneops/backend/logger"
	"strconv"

	"oneops/backend/services"

	"github.com/gin-gonic/gin"
	"go.uber.org/zap"
)

// ============================================
// 告警规则管理 API (P2)
// ============================================

// GetAlertRules 获取告警规则列表
// GET /api/monitoring/alerts/rules
func (c *MonitoringController) GetAlertRules(ctx *gin.Context) {
	rules, err := c.monitoringService.GetAlertRules()
	if err != nil {
		logger.Error("获取告警规则失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}
	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": rules})
}

// CreateAlertRule 创建告警规则
// POST /api/monitoring/alerts/rules
func (c *MonitoringController) CreateAlertRule(ctx *gin.Context) {
	var rule services.AlertRule
	if err := ctx.ShouldBindJSON(&rule); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "参数错误"})
		return
	}

	if err := c.monitoringService.CreateAlertRule(&rule); err != nil {
		logger.Error("创建告警规则失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}

// UpdateAlertRule 更新告警规则
// PUT /api/monitoring/alerts/rules/:id
func (c *MonitoringController) UpdateAlertRule(ctx *gin.Context) {
	id := ctx.Param("id")
	var rule services.AlertRule
	if err := ctx.ShouldBindJSON(&rule); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "参数错误"})
		return
	}
	rule.ID = id

	if err := c.monitoringService.UpdateAlertRule(&rule); err != nil {
		logger.Error("更新告警规则失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}

// DeleteAlertRule 删除告警规则
// DELETE /api/monitoring/alerts/rules/:id
func (c *MonitoringController) DeleteAlertRule(ctx *gin.Context) {
	id := ctx.Param("id")

	if err := c.monitoringService.DeleteAlertRule(id); err != nil {
		logger.Error("删除告警规则失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}

// ToggleAlertRule 启用/禁用告警规则
// PUT /api/monitoring/alerts/rules/:id/toggle
func (c *MonitoringController) ToggleAlertRule(ctx *gin.Context) {
	id := ctx.Param("id")

	if err := c.monitoringService.ToggleAlertRule(id); err != nil {
		logger.Error("切换告警规则状态失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}

// ============================================
// 通知渠道管理 API (P2)
// ============================================

// GetNotificationChannels 获取通知渠道列表
// GET /api/monitoring/notifications/channels
func (c *MonitoringController) GetNotificationChannels(ctx *gin.Context) {
	channels, err := c.monitoringService.GetNotificationChannels()
	if err != nil {
		logger.Error("获取通知渠道失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}
	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": channels})
}

// CreateNotificationChannel 创建通知渠道
// POST /api/monitoring/notifications/channels
func (c *MonitoringController) CreateNotificationChannel(ctx *gin.Context) {
	var channel services.NotificationChannel
	if err := ctx.ShouldBindJSON(&channel); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "参数错误"})
		return
	}

	id, err := c.monitoringService.CreateNotificationChannel(&channel)
	if err != nil {
		logger.Error("创建通知渠道失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": gin.H{"id": id}})
}

// UpdateNotificationChannel 更新通知渠道
// PUT /api/monitoring/notifications/channels/:id
func (c *MonitoringController) UpdateNotificationChannel(ctx *gin.Context) {
	idStr := ctx.Param("id")
	id, err := strconv.ParseUint(idStr, 10, 32)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "无效的渠道ID"})
		return
	}

	var channel services.NotificationChannel
	if err := ctx.ShouldBindJSON(&channel); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "参数错误"})
		return
	}
	channel.ID = uint(id)

	if err := c.monitoringService.UpdateNotificationChannel(&channel); err != nil {
		logger.Error("更新通知渠道失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}

// DeleteNotificationChannel 删除通知渠道
// DELETE /api/monitoring/notifications/channels/:id
func (c *MonitoringController) DeleteNotificationChannel(ctx *gin.Context) {
	idStr := ctx.Param("id")
	id, err := strconv.ParseUint(idStr, 10, 32)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "无效的渠道ID"})
		return
	}

	if err := c.monitoringService.DeleteNotificationChannel(uint(id)); err != nil {
		logger.Error("删除通知渠道失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}

// TestNotificationChannel 测试通知渠道
// POST /api/monitoring/notifications/channels/:id/test
func (c *MonitoringController) TestNotificationChannel(ctx *gin.Context) {
	idStr := ctx.Param("id")
	id, err := strconv.ParseUint(idStr, 10, 32)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "无效的渠道ID"})
		return
	}

	if err := c.monitoringService.TestNotificationChannel(uint(id)); err != nil {
		logger.Error("测试通知渠道失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "测试通知已发送"})
}

// ============================================
// 巡检报告 API (P3)
// ============================================

// GetReports 获取巡检报告列表
// GET /api/monitoring/reports
func (c *MonitoringController) GetReports(ctx *gin.Context) {
	params := services.ReportQueryParams{
		Page:     1,
		PageSize: 20,
	}
	if pageStr := ctx.Query("page"); pageStr != "" {
		if page, err := strconv.Atoi(pageStr); err == nil {
			params.Page = page
		}
	}
	if pageSizeStr := ctx.Query("pageSize"); pageSizeStr != "" {
		if pageSize, err := strconv.Atoi(pageSizeStr); err == nil {
			params.PageSize = pageSize
		}
	}
	params.ReportType = ctx.Query("reportType")
	params.Status = ctx.Query("status")

	result, err := c.monitoringService.GetReports(params)
	if err != nil {
		logger.Error("获取巡检报告失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}
	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": result})
}

// CreateReport 创建巡检报告
// POST /api/monitoring/reports
func (c *MonitoringController) CreateReport(ctx *gin.Context) {
	var req services.CreateReportRequest
	if err := ctx.ShouldBindJSON(&req); err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "参数错误"})
		return
	}

	// 从 JWT 中获取当前用户名
	createdBy := "admin"
	if user, exists := ctx.Get("username"); exists {
		createdBy = user.(string)
	}

	reportID, err := c.monitoringService.CreateReport(&req, createdBy)
	if err != nil {
		logger.Error("创建巡检报告失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": gin.H{"reportId": reportID}})
}

// GetReportDetail 获取巡检报告详情
// GET /api/monitoring/reports/:id
func (c *MonitoringController) GetReportDetail(ctx *gin.Context) {
	idStr := ctx.Param("id")
	id, err := strconv.ParseUint(idStr, 10, 64)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "无效的报告ID"})
		return
	}

	report, err := c.monitoringService.GetReportDetail(uint64(id))
	if err != nil {
		logger.Error("获取巡检报告详情失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": report})
}

// ExportReport 导出巡检报告
// GET /api/monitoring/reports/:id/export
func (c *MonitoringController) ExportReport(ctx *gin.Context) {
	idStr := ctx.Param("id")
	id, err := strconv.ParseUint(idStr, 10, 64)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "无效的报告ID"})
		return
	}

	format := ctx.DefaultQuery("format", "pdf")

	filePath, err := c.monitoringService.ExportReport(uint64(id), format)
	if err != nil {
		logger.Error("导出巡检报告失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success", "data": gin.H{"filePath": filePath}})
}

// DeleteReport 删除巡检报告
// DELETE /api/monitoring/reports/:id
func (c *MonitoringController) DeleteReport(ctx *gin.Context) {
	idStr := ctx.Param("id")
	id, err := strconv.ParseUint(idStr, 10, 64)
	if err != nil {
		ctx.JSON(http.StatusBadRequest, gin.H{"code": -1, "message": "无效的报告ID"})
		return
	}

	if err := c.monitoringService.DeleteReport(uint64(id)); err != nil {
		logger.Error("删除巡检报告失败", zap.Error(err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"code": -1, "message": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"code": 0, "message": "success"})
}
