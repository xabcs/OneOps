# OneOps 环境变量配置示例
# 复制此文件为 .env 并修改配置

# 应用基础 URL（默认为 "/"）
# 如果使用子目录，必须以 "/" 结尾，如 "/admin/"
VITE_BASE_URL=/

# 应用标题
VITE_APP_TITLE=OneOps

# 应用描述
VITE_APP_DESC=OneOps is an intelligent operations management platform

# 图标名称前缀
VITE_ICON_PREFIX=icon

# 本地 SVG 图标组件前缀（必须包含 VITE_ICON_PREFIX）
# 格式: {VITE_ICON_PREFIX}-{local icon name}
VITE_ICON_LOCAL_PREFIX=icon-local

# 认证路由模式: static | dynamic
VITE_AUTH_ROUTE_MODE=dynamic

# 静态认证路由首页
VITE_ROUTE_HOME=home

# 默认菜单图标
VITE_MENU_ICON=mdi:menu

# 开发模式下是否启用 HTTP 代理
VITE_HTTP_PROXY=Y

# 后端服务基础 URL
VITE_SERVICE_BASE_URL=http://localhost:8082/api

# Vue Router 模式: hash | history | memory
VITE_ROUTER_HISTORY_MODE=history

# 后端服务成功代码（收到此代码表示请求成功）
VITE_SERVICE_SUCCESS_CODE=200

# 后端服务登出代码（收到此代码将登出并重定向到登录页）
VITE_SERVICE_LOGOUT_CODES=8888,8889

# 后端服务模态登出代码（收到此代码将显示模态框并登出）
VITE_SERVICE_MODAL_LOGOUT_CODES=7777,7778

# 后端服务令牌过期代码（收到此代码将刷新令牌并重新发送请求）
VITE_SERVICE_EXPIRED_TOKEN_CODES=9999,9998,3333

# 静态路由模式下的超级角色
VITE_STATIC_SUPER_ROLE=R_SUPER

# Source Map 配置
VITE_SOURCE_MAP=N

# 用于区分不同域名的存储前缀
VITE_STORAGE_PREFIX=ONEOPS_

# 是否自动检测更新
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# 是否在终端显示代理 URL 日志
VITE_PROXY_LOG=Y

# 是否启动编辑器（仅开发模式可用）
VITE_DEVTOOLS_LAUNCH_EDITOR=code
