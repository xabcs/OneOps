// ========== 表单验证规则 ==========
const serverFormRules: FormRules = {
  hostname: [
    { required: true, message: '请输入主机名', trigger: 'blur' },
    { min: 2, max: 100, message: '主机名长度在 2 到 100 个字符', trigger: 'blur' },
